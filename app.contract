shape Viewport
  pointer: string
  width: number
  height: number

shape Hud
  mode: string
  race: string
  subtitle: string
  seconds: number
  finished: bool
  round: number
  enemies: number
  hits: number
  phase: string
  move_x: number
  move_y: number

component ExactBeatEmUp
  state playing = false
  state paused = false
  state again = false
  state mode = 0
  state race = 0
  state character = 1
  state home = ""
  state under = ""
  state lent = false
  state arrived = ""
  resource viewport = exactViewport() as shape Viewport
  resource hud = exactSurface("world") as shape Hud
  derive touch = viewport.pointer == "coarse"
  derive narrow = viewport.width < 600
  derive stickX = paused ? 0 : hud.move_x
  derive stickY = paused ? 0 : hud.move_y
  derive stickActive = stickX * stickX + stickY * stickY > 0.0001
  derive sprintRight = narrow ? "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 30px)" : "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 128px)"
  derive sprintBottom = narrow ? "calc(env(safe-area-inset-bottom) + 132px)" : "calc(env(safe-area-inset-bottom) + 24px)"
  derive slideRight = narrow ? "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 34px)" : "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 136px)"
  derive slideBottom = narrow ? "calc(env(safe-area-inset-bottom) + 228px)" : "calc(env(safe-area-inset-bottom) + 120px)"
  derive jumpBottom = narrow ? "calc(env(safe-area-inset-bottom) + 24px)" : "calc(env(safe-area-inset-bottom) + 56px)"

  action pickRunnerA
    character = 1

  action pickRunnerB
    character = 2

  action chooseRace0
    mode = 0
    race = 0
    playing = true

  action chooseRace1
    mode = 0
    race = 1
    playing = true

  action chooseRace2
    mode = 0
    race = 2
    playing = true

  action chooseArena
    mode = 1
    race = 0
    playing = true

  action chooseCity
    mode = 3
    race = 0
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action chooseFromPause0
    mode = 0
    race = 0
    again = not again
    paused = false

  action chooseFromPause1
    mode = 0
    race = 1
    again = not again
    paused = false

  action chooseFromPause2
    mode = 0
    race = 2
    again = not again
    paused = false

  action chooseArenaFromPause
    mode = 1
    race = 0
    again = not again
    paused = false

  action chooseCityFromPause
    mode = 3
    race = 0
    again = not again
    paused = false

  action touchDown(e: PointerEvent)
    let down = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
    home = down
    under = down

  action glide(e: PointerEvent)
    let over = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
    if e.buttons != 0 and over != under
      if under == "sprint" and lent
        postMessage("touch sprint off", "world")
        lent = false
      if over == "jump"
        postMessage("touch jump", "world")
      if over == "slide"
        postMessage("touch slide", "world")
      if over == "sprint" and home != "sprint"
        postMessage("touch sprint on", "world")
        lent = true
      under = over
      arrived = over

  action touchUp
    if lent
      postMessage("touch sprint off", "world")
      lent = false
    under = ""
    home = ""

  view
    main width="100%" height="100%" position="relative" viewport-fit="cover" background-color="#101822" color="#f4f7f8"
      if playing
        canvas surface=world(seed=7, character=character, mode=mode, race=race, paused=paused, restart=again) testId="world" width="100%" height="100%" position="absolute" top=0 left=0 right=0 bottom=0 overflow="hidden" touch-action="none"
          row position="absolute" top="calc(env(safe-area-inset-top) + 12px)" left="calc(env(safe-area-inset-left) + 20px)" right="calc(env(safe-area-inset-right) + 20px)" justify-content="space-between" pointer-events="none"
            row gap=8 pointer-events="auto"
              if hud.mode == "arena"
                text `ROUND ${hud.round}` padding=10 border-radius=12 background-color="#101822bb" font-weight=700
              else
                text hud.race padding=10 border-radius=12 background-color="#101822bb" font-weight=700
              if hud.mode == "arena"
                text `HOSTILES ${hud.enemies}` padding=10 border-radius=12 background-color="#101822bb" font-variant-numeric="tabular-nums"
              else
                text `${hud.seconds.toFixed(1)}s` padding=10 border-radius=12 background-color="#101822bb" font-variant-numeric="tabular-nums"
            row gap=8 pointer-events="auto"
              if paused
                button appearance="none" press=restart testId="restart" aria-label="Restart" padding=10 border-radius=12 background-color="#2b5364" color="#ffffff"
                  text "Restart"
              button appearance="none" press=togglePause testId="pause" aria-label=(paused ? "Resume" : "Pause") padding=10 border-radius=12 background-color="#101822bb" color="#ffffff"
                text (paused ? "Resume" : "Pause")
          if hud.mode == "arena"
            column testId="combat-hud" position="absolute" top="calc(env(safe-area-inset-top) + 62px)" left="calc(env(safe-area-inset-left) + 20px)" gap=4 pointer-events="none"
              text `DAMAGE ${hud.hits} / 3` font-size=14 color=(hud.hits >= 2 ? "#ff7b7b" : "#c7d8e5") font-variant-numeric="tabular-nums"
              text hud.phase font-size=12 color="#dbe9f1"
          if hud.mode == "city"
            column testId="city-hud" position="absolute" top="calc(env(safe-area-inset-top) + 62px)" left="calc(env(safe-area-inset-left) + 20px)" gap=4 pointer-events="none"
              text hud.subtitle padding=8 border-radius=10 background-color="#101822bb" font-size=14 color="#bff3ff"
              text `STEP ${hud.phase}` font-size=12 color="#dbe9f1"
          if hud.finished
            text "FINISH" position="absolute" top="46%" left=0 right=0 padding=18 text-align="center" border-radius=16 background-color="#0b1824dd" font-size=30 font-weight=800
          if paused
            column position="absolute" top="calc(env(safe-area-inset-top) + 78px)" right="calc(env(safe-area-inset-right) + 20px)" padding=16 gap=8 border-radius=16 background-color="#101822ee"
              text "Choose a level" font-weight=700
              button press=chooseFromPause0 testId="race-skyline" aria-label="Skyline Sprint"
                text "Skyline Sprint"
              button press=chooseFromPause1 testId="race-switchback" aria-label="Switchback Run"
                text "Switchback Run"
              button press=chooseFromPause2 testId="race-helix" aria-label="Helix Heights"
                text "Helix Heights"
              button press=chooseArenaFromPause testId="arena-holdout" aria-label="Rooftop Holdout"
                text "Rooftop Holdout"
              button press=chooseCityFromPause testId="city-neon" aria-label="Neon Rain"
                text "Neon Rain"
          if touch
            button action="move" role="slider" appearance="none" testId="move" position="absolute" left="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom="calc(env(safe-area-inset-bottom) + 24px)" width=112 height=112 box-sizing="border-box" padding=0 border-radius=56 background-color="#101822aa" border="1px solid #d9edf580" touch-action="none" aria-label="Move"
              column position="absolute" left=13 top=13 width=84 height=84 box-sizing="border-box" border-radius=42 border="1px solid #d9edf530" pointer-events="none" aria-hidden=true
              column testId="move-thumb" position="absolute" left=(33 + stickX * 30) top=(33 - stickY * 30) width=44 height=44 box-sizing="border-box" border-radius=22 background-color=(stickActive ? "#e5f6fff2" : "#d9edf5bb") border="2px solid #ffffffcc" box-shadow="0 2px 8px #00000055" pointer-events="none" aria-hidden=true
              text "Move" position="absolute" left=0 right=0 bottom=6 text-align="center" font-size=11 font-weight=600 color="#ffffff" pointer-events="none" aria-hidden=true
            button action="sprint" id="sprint" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="sprint" position="absolute" right=sprintRight bottom=sprintBottom width=84 height=84 box-sizing="border-box" padding=0 border-radius=42 background-color="#101822bb" border="1px solid #d9edf580" color="#ffffff" display="flex" align-items="center" justify-content="center" aria-label="Sprint"
              text "Sprint" font-size=14 font-weight=600 pointer-events="none"
            button action="slide" id="slide" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="slide" position="absolute" right=slideRight bottom=slideBottom width=76 height=76 box-sizing="border-box" padding=0 border-radius=38 background-color="#101822bb" border="1px solid #d9edf580" color="#ffffff" display="flex" align-items="center" justify-content="center" aria-label="Slide"
              text "Slide" font-size=14 font-weight=600 pointer-events="none"
            button action="jump" id="jump" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="jump" position="absolute" right="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom=jumpBottom width=96 height=96 box-sizing="border-box" padding=0 border-radius=48 background-color="#244a60dd" border="1px solid #d9edf5aa" color="#ffffff" display="flex" align-items="center" justify-content="center" aria-label="Jump"
              text "Jump" font-size=16 font-weight=700 pointer-events="none"
      else
        row width="100%" height="100%" box-sizing="border-box" padding=24 align-items="center" justify-content="center" gap=28 flex-wrap="wrap" overflow="auto"
          column align-items="center" gap=10
            canvas surface=world(seed=3, character=character, mode=4, race=0, paused=false, restart=false) testId="locker" aria-label=(character == 1 ? "Ash, turning" : "Ember, turning") width=210 height=264 border-radius=16 overflow="hidden" pointer-events="none"
            text "Choose a runner" font-size=14 font-weight=700 color="#b8c8ce"
            row role="radiogroup" aria-label="Runner" gap=8
              button role="radio" appearance="none" aria-checked=(character == 1) press=pickRunnerA testId="runner-a" aria-label="Ash" min-width=88 padding=10 border-radius=12 background-color=(character == 1 ? "#2b5364" : "#101822") border=(character == 1 ? "2px solid #d9edf5" : "2px solid #3a5566") color="#ffffff"
                text "Ash" font-weight=700
              button role="radio" appearance="none" aria-checked=(character == 2) press=pickRunnerB testId="runner-b" aria-label="Ember" min-width=88 padding=10 border-radius=12 background-color=(character == 2 ? "#2b5364" : "#101822") border=(character == 2 ? "2px solid #d9edf5" : "2px solid #3a5566") color="#ffffff"
                text "Ember" font-weight=700
          column align-items="center" justify-content="center" gap=16 max-width="26rem"
            text "ROOFTOP RUMBLE" role="heading" font-size=42 font-weight=700 letter-spacing=2 text-align="center"
            text "Pick a route or hold the rooftop against escalating hordes." max-width="23.75rem" text-align="center" color="#b8c8ce"
            text "WASD or arrows move. Shift sprints. Space jumps. C slides." max-width="22.5rem" text-align="center" color="#b8c8ce"
            text "The camera follows your direction. Swipe or drag the scene to look around." max-width="22.5rem" text-align="center" color="#b8c8ce"
            row gap=12 flex-wrap="wrap" justify-content="center"
              button buttonStyle="filled" press=chooseRace0 autofocus aria-label="Skyline Sprint" testId="play"
                text "Skyline Sprint"
              button buttonStyle="filled" press=chooseRace1 aria-label="Switchback Run" testId="race-switchback"
                text "Switchback Run"
              button buttonStyle="filled" press=chooseRace2 aria-label="Helix Heights" testId="race-helix"
                text "Helix Heights"
              button buttonStyle="filled" press=chooseArena aria-label="Rooftop Holdout" testId="arena"
                text "Rooftop Holdout"
              button buttonStyle="filled" press=chooseCity aria-label="Neon Rain" testId="city"
                text "Neon Rain"
