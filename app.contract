shape Viewport
  pointer: string
  width: number
  height: number

component ExactBeatEmUp
  state playing = false
  state paused = false
  state again = false
  state sprinting = false
  resource viewport = exactViewport() as shape Viewport
  derive touch = viewport.pointer == "coarse"
  derive portrait = viewport.height > viewport.width

  action play
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action jump
    postMessage("jump", "world")

  action toggleSprint
    sprinting = not sprinting

  view
    main width="100%" height="100%" position="relative" background-color="#101822" color="#f4f7f8"
      if playing
        canvas surface=world(seed=7, paused=paused, restart=again, sprint=sprinting) testId="world" width="100%" height="100%" position="absolute" top=0 left=0 right=0 bottom=0 overflow="hidden"
          if touch
            button action="move" appearance="none" role="slider" testId="move" position="absolute" left=20 bottom=20 width=104 height=104 border-radius=52 background-color="#f3f7ff42" border-width=1 border-color="#f3f7ff80" backdrop-filter="blur(18px) saturate(1.25)" aria-label="Move"
              text "Move" color="#ffffff"
        if touch
          row position="absolute" top=(portrait ? "env(safe-area-inset-top)" : 20) left=20 right=20 padding=12 justify-content="space-between" pointer-events="none"
            button buttonStyle="glass" press=togglePause testId="pause" pointer-events="auto" aria-label=(paused ? "Resume" : "Pause")
              text (paused ? "Resume" : "Pause")
            if paused
              button buttonStyle="prominent-glass" press=restart testId="restart" pointer-events="auto" aria-label="Restart"
                text "Restart"
          row position="absolute" right=20 bottom=(portrait ? "env(safe-area-inset-bottom)" : 20) gap=12 padding=12 pointer-events="none"
            if sprinting
              button buttonStyle="prominent-glass" press=toggleSprint testId="sprint" pointer-events="auto" aria-label="Sprint" aria-pressed=true
                text "Sprint"
            else
              button buttonStyle="glass" press=toggleSprint testId="sprint" pointer-events="auto" aria-label="Sprint" aria-pressed=false
                text "Sprint"
            button buttonStyle="glass" press=jump testId="jump" pointer-events="auto" aria-label="Jump"
              text "Jump"
      else
        column width="100%" height="100%" box-sizing="border-box" padding=32 align-items="center" justify-content="center" gap=24
          text "ROOFTOP RUMBLE" role="heading" font-size=42 font-weight=700 letter-spacing=2 text-align="center"
          text "A flat platform for a future beat 'em up." max-width=360 text-align="center" color="#b8c8ce"
          text "Move with WASD or the arrow keys. Hold Shift to sprint. Space jumps." max-width=360 text-align="center" color="#b8c8ce"
          button buttonStyle="filled" press=play autofocus aria-label="Play" testId="play"
            text "Play"
