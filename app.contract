shape Viewport
  pointer: string
  width: number
  height: number

component ExactBeatEmUp
  state playing = false
  state paused = false
  state again = false
  state home = ""
  state under = ""
  state lent = false
  state arrived = ""
  resource viewport = exactViewport() as shape Viewport
  derive touch = viewport.pointer == "coarse"
  derive narrow = viewport.width < 600
  derive sprintRight = narrow ? "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 30px)" : "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 128px)"
  derive sprintBottom = narrow ? "calc(env(safe-area-inset-bottom) + 132px)" : "calc(env(safe-area-inset-bottom) + 24px)"
  derive slideRight = narrow ? "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 34px)" : "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 136px)"
  derive slideBottom = narrow ? "calc(env(safe-area-inset-bottom) + 228px)" : "calc(env(safe-area-inset-bottom) + 120px)"
  derive jumpBottom = narrow ? "calc(env(safe-area-inset-bottom) + 24px)" : "calc(env(safe-area-inset-bottom) + 56px)"

  action play
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action touchDown(e: PointerEvent)
    let down = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
    home = down
    under = down

  action glide(e: PointerEvent)
    let over = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
    if e.buttons != 0 and over != under
      if under == "sprint" and lent
        postMessage("touch sprint off", "world")
        lent = false
      if over == "jump"
        postMessage("touch jump", "world")
      if over == "slide"
        postMessage("touch slide", "world")
      if over == "sprint" and home != "sprint"
        postMessage("touch sprint on", "world")
        lent = true
      under = over
      arrived = over

  action touchUp
    if lent
      postMessage("touch sprint off", "world")
      lent = false
    under = ""
    home = ""

  view
    main width="100%" height="100%" position="relative" viewport-fit="cover" background-color="#101822" color="#f4f7f8"
      if playing
        canvas surface=world(seed=7, paused=paused, restart=again) testId="world" width="100%" height="100%" position="absolute" top=0 left=0 right=0 bottom=0 overflow="hidden"
          if touch
            button action="move" role="slider" appearance="none" testId="move" position="absolute" left="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom="calc(env(safe-area-inset-bottom) + 24px)" width=112 height=112 border-radius=56 background-color="transparent" aria-label="Move"
            button action="sprint" id="sprint" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="sprint" position="absolute" right=sprintRight bottom=sprintBottom width=84 height=84 border-radius=42 background-color="transparent" aria-label="Sprint"
            button action="slide" id="slide" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="slide" position="absolute" right=slideRight bottom=slideBottom width=76 height=76 border-radius=38 background-color="transparent" aria-label="Slide"
            button action="jump" id="jump" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="jump" position="absolute" right="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom=jumpBottom width=96 height=96 border-radius=48 background-color="transparent" aria-label="Jump"
        if touch
          row position="absolute" top="calc(env(safe-area-inset-top) + 12px)" left="calc(env(safe-area-inset-left) + 20px)" right="calc(env(safe-area-inset-right) + 20px)" justify-content="space-between" pointer-events="none"
            button buttonStyle="glass" press=togglePause testId="pause" pointer-events="auto" aria-label=(paused ? "Resume" : "Pause")
              text (paused ? "Resume" : "Pause")
            if paused
              button buttonStyle="prominent-glass" press=restart testId="restart" pointer-events="auto" aria-label="Restart"
                text "Restart"
          button buttonStyle="glass" testId="move-face" position="absolute" left="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom="calc(env(safe-area-inset-bottom) + 24px)" width=112 height=112 pointer-events="none" aria-hidden=true
            text "Move"
          button buttonStyle=(under == "sprint" ? "prominent-glass" : "glass") testId="sprint-face" position="absolute" right=sprintRight bottom=sprintBottom width=84 height=84 pointer-events="none" aria-hidden=true
            text "Sprint"
          button buttonStyle=(under == "slide" ? "prominent-glass" : "glass") testId="slide-face" position="absolute" right=slideRight bottom=slideBottom width=76 height=76 pointer-events="none" aria-hidden=true
            text "Slide"
          button buttonStyle=(under == "jump" ? "prominent-glass" : "glass") testId="jump-face" position="absolute" right="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom=jumpBottom width=96 height=96 pointer-events="none" aria-hidden=true
            text "Jump"
      else
        column width="100%" height="100%" box-sizing="border-box" padding=32 align-items="center" justify-content="center" gap=24
          text "ROOFTOP RUMBLE" role="heading" font-size=42 font-weight=700 letter-spacing=2 text-align="center"
          text "An obstacle park for a future beat 'em up." max-width=360 text-align="center" color="#b8c8ce"
          text "Move with WASD or the arrow keys. Hold Shift to sprint. Space jumps. C slides." max-width=360 text-align="center" color="#b8c8ce"
          button buttonStyle="filled" press=play autofocus aria-label="Play" testId="play"
            text "Play"
