shape Viewport
  pointer: string
  width: number
  height: number

shape Hud
  mode: string
  race: string
  subtitle: string
  seconds: number
  finished: bool
  round: number
  enemies: number
  hits: number
  phase: string
  move_x: number
  move_y: number

component ExactBeatEmUp
  state playing = false
  state paused = false
  state again = false
  state mode = 0
  state race = 0
  state home = ""
  state under = ""
  state lent = false
  state arrived = ""
  resource viewport = exactViewport() as shape Viewport
  resource hud = exactSurface("world") as shape Hud
  derive touch = viewport.pointer == "coarse"
  derive narrow = viewport.width < 600
  derive stickX = paused ? 0 : hud.move_x
  derive stickY = paused ? 0 : hud.move_y
  derive stickActive = stickX * stickX + stickY * stickY > 0.0001
  derive sprintRight = narrow ? "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 30px)" : "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 128px)"
  derive sprintBottom = narrow ? "calc(env(safe-area-inset-bottom) + 132px)" : "calc(env(safe-area-inset-bottom) + 24px)"
  derive slideRight = narrow ? "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 34px)" : "calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 136px)"
  derive slideBottom = narrow ? "calc(env(safe-area-inset-bottom) + 228px)" : "calc(env(safe-area-inset-bottom) + 120px)"
  derive jumpBottom = narrow ? "calc(env(safe-area-inset-bottom) + 24px)" : "calc(env(safe-area-inset-bottom) + 56px)"

  action chooseRace0
    mode = 0
    race = 0
    playing = true

  action chooseRace1
    mode = 0
    race = 1
    playing = true

  action chooseRace2
    mode = 0
    race = 2
    playing = true

  action chooseArena
    mode = 1
    race = 0
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action chooseFromPause0
    mode = 0
    race = 0
    again = not again
    paused = false

  action chooseFromPause1
    mode = 0
    race = 1
    again = not again
    paused = false

  action chooseFromPause2
    mode = 0
    race = 2
    again = not again
    paused = false

  action chooseArenaFromPause
    mode = 1
    race = 0
    again = not again
    paused = false

  action touchDown(e: PointerEvent)
    let down = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
    home = down
    under = down

  action glide(e: PointerEvent)
    let over = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
    if e.buttons != 0 and over != under
      if under == "sprint" and lent
        postMessage("touch sprint off", "world")
        lent = false
      if over == "jump"
        postMessage("touch jump", "world")
      if over == "slide"
        postMessage("touch slide", "world")
      if over == "sprint" and home != "sprint"
        postMessage("touch sprint on", "world")
        lent = true
      under = over
      arrived = over

  action touchUp
    if lent
      postMessage("touch sprint off", "world")
      lent = false
    under = ""
    home = ""

  view
    main width="100%" height="100%" position="relative" viewport-fit="cover" background-color="#070b17" color="#f3f7ff"
      if playing
        canvas surface=world(seed=7, mode=mode, race=race, paused=paused, restart=again) testId="world" width="100%" height="100%" position="absolute" top=0 left=0 right=0 bottom=0 overflow="hidden" touch-action="none"
          row position="absolute" top="calc(env(safe-area-inset-top) + 12px)" left="calc(env(safe-area-inset-left) + 20px)" right="calc(env(safe-area-inset-right) + 20px)" justify-content="space-between" pointer-events="none"
            row gap=8 pointer-events="auto"
              if hud.mode == "arena"
                text `ROUND ${hud.round}` padding=10 border-radius=12 background-color="#071426dd" border="1px solid #00e5ff66" color="#9cf8ff" font-weight=700
              else
                text hud.race padding=10 border-radius=12 background-color="#071426dd" border="1px solid #00e5ff66" color="#9cf8ff" font-weight=700
              if hud.mode == "arena"
                text `HOSTILES ${hud.enemies}` padding=10 border-radius=12 background-color="#071426dd" border="1px solid #ff3eb566" color="#ffb8df" font-variant-numeric="tabular-nums"
              else
                text `${hud.seconds.toFixed(1)}s` padding=10 border-radius=12 background-color="#071426dd" border="1px solid #00e5ff66" color="#d8fbff" font-variant-numeric="tabular-nums"
            row gap=8 pointer-events="auto"
              if paused
                button appearance="none" press=restart testId="restart" aria-label="Restart" padding=10 border-radius=12 background-color="#142b4c" border="1px solid #00e5ff88" color="#d8fbff"
                  text "Restart"
              button appearance="none" press=togglePause testId="pause" aria-label=(paused ? "Resume" : "Pause") padding=10 border-radius=12 background-color="#071426dd" border="1px solid #d7e7ff44" color="#f3f7ff"
                text (paused ? "Resume" : "Pause")
          if hud.mode == "arena"
            column testId="combat-hud" position="absolute" top="calc(env(safe-area-inset-top) + 62px)" left="calc(env(safe-area-inset-left) + 20px)" gap=4 pointer-events="none"
              text `DAMAGE ${hud.hits} / 3` font-size=14 color=(hud.hits >= 2 ? "#ff78a9" : "#9cf8ff") font-variant-numeric="tabular-nums"
              text hud.phase font-size=12 color="#c3c8e8"
          if hud.finished
            text "SIGNAL LOCKED // FINISH" position="absolute" top="46%" left=0 right=0 padding=18 text-align="center" border-radius=16 background-color="#071426ee" border="1px solid #00e5ffaa" color="#9cf8ff" font-size=30 font-weight=800
          if paused
            column position="absolute" top="calc(env(safe-area-inset-top) + 78px)" right="calc(env(safe-area-inset-right) + 20px)" padding=16 gap=8 border-radius=16 background-color="#071426f2" border="1px solid #00e5ff66"
              text "SELECT A ROUTE" font-weight=700 color="#9cf8ff"
              button press=chooseFromPause0 testId="race-skyline" aria-label="Skyline Sprint" background-color="#132645" color="#f3f7ff"
                text "Skyline Sprint"
              button press=chooseFromPause1 testId="race-switchback" aria-label="Switchback Run" background-color="#132645" color="#f3f7ff"
                text "Switchback Run"
              button press=chooseFromPause2 testId="race-helix" aria-label="Helix Heights" background-color="#132645" color="#f3f7ff"
                text "Helix Heights"
              button press=chooseArenaFromPause testId="arena-holdout" aria-label="Rooftop Holdout" background-color="#331d48" color="#ffd1ef"
                text "Rooftop Holdout"
          if touch
            button action="move" role="slider" appearance="none" testId="move" position="absolute" left="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom="calc(env(safe-area-inset-bottom) + 24px)" width=112 height=112 box-sizing="border-box" padding=0 border-radius=56 background-color="#101822aa" border="1px solid #d9edf580" touch-action="none" aria-label="Move"
              column position="absolute" left=13 top=13 width=84 height=84 box-sizing="border-box" border-radius=42 border="1px solid #00e5ff55" pointer-events="none" aria-hidden=true
              column testId="move-thumb" position="absolute" left=(33 + stickX * 30) top=(33 - stickY * 30) width=44 height=44 box-sizing="border-box" border-radius=22 background-color=(stickActive ? "#9cf8fff2" : "#8ec9d6bb") border="2px solid #ffffffcc" box-shadow="0 2px 8px #00e5ff55" pointer-events="none" aria-hidden=true
              text "Move" position="absolute" left=0 right=0 bottom=6 text-align="center" font-size=11 font-weight=600 color="#d8fbff" pointer-events="none" aria-hidden=true
            button action="sprint" id="sprint" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="sprint" position="absolute" right=sprintRight bottom=sprintBottom width=84 height=84 box-sizing="border-box" padding=0 border-radius=42 background-color="#132645cc" border="1px solid #00e5ff88" color="#d8fbff" display="flex" align-items="center" justify-content="center" aria-label="Sprint"
              text "Sprint" font-size=14 font-weight=600 pointer-events="none"
            button action="slide" id="slide" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="slide" position="absolute" right=slideRight bottom=slideBottom width=76 height=76 box-sizing="border-box" padding=0 border-radius=38 background-color="#331d48cc" border="1px solid #ff3eb588" color="#ffd1ef" display="flex" align-items="center" justify-content="center" aria-label="Slide"
              text "Slide" font-size=14 font-weight=600 pointer-events="none"
            button action="jump" id="jump" pointerdown=touchDown pointermove=glide pointerup=touchUp touch-action="none" appearance="none" testId="jump" position="absolute" right="calc(max(env(safe-area-inset-left), env(safe-area-inset-right)) + 24px)" bottom=jumpBottom width=96 height=96 box-sizing="border-box" padding=0 border-radius=48 background-color="#104759dd" border="1px solid #9cf8ffbb" color="#f3f7ff" display="flex" align-items="center" justify-content="center" aria-label="Jump"
              text "Jump" font-size=16 font-weight=700 pointer-events="none"
      else
        column width="100%" height="100%" box-sizing="border-box" padding=32 align-items="center" justify-content="center" gap=20 background-color="#070b17"
          text "NEON // ROOFTOP RUMBLE" role="heading" font-size=42 font-weight=800 letter-spacing=2 text-align="center" color="#9cf8ff"
          text "Run the skyline. Break the signal. Survive the holdout." max-width="23.75rem" text-align="center" color="#e2c7ff"
          text "WASD or arrows move. Shift sprints. Space jumps. C slides." max-width="22.5rem" text-align="center" color="#a6b9d7"
          text "The camera follows your direction. Swipe or drag the scene to look around." max-width="22.5rem" text-align="center" color="#a6b9d7"
          row gap=12 flex-wrap="wrap" justify-content="center"
            button press=chooseRace0 autofocus aria-label="Skyline Sprint" testId="play" background-color="#104759" color="#d8fbff"
              text "Skyline Sprint"
            button press=chooseRace1 aria-label="Switchback Run" testId="race-switchback" background-color="#132645" color="#d8fbff"
              text "Switchback Run"
            button press=chooseRace2 aria-label="Helix Heights" testId="race-helix" background-color="#132645" color="#d8fbff"
              text "Helix Heights"
            button press=chooseArena aria-label="Rooftop Holdout" testId="arena" background-color="#331d48" color="#ffd1ef"
              text "Rooftop Holdout"
