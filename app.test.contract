test "Play opens the platform"
  expect tree has "play"
  tap "play"
  expect tree has "world"
  expect tree missing "move"

test "The world accepts a jump input"
  tap "play"
  type "world" key "Space"
  clock +250
  expect tree has "world"

test "A touch screen shows the stick and the round buttons"
  prefer pointer coarse
  tap "play"
  expect tree has "move"
  expect tree has "sprint"
  expect tree has "jump"
  expect tree has "pause"
