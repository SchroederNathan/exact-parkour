test "Play opens the platform"
  expect tree has "play"
  tap "play"
  expect tree has "world"
  expect tree missing "move"

test "The world accepts a jump input"
  tap "play"
  type "world" key "Space"
  clock +250
  expect tree has "world"

test "A touch screen shows the stick and the round buttons"
  prefer pointer coarse
  tap "play"
  expect tree has "move"
  expect tree has "sprint"
  expect tree has "slide"
  expect tree has "jump"
  expect tree has "pause"

test "A finger that slides from Sprint presses the button it arrives on"
  prefer pointer coarse
  tap "play"
  tap "sprint" drag to "jump" hold 200
  expect state arrived == "jump"
  expect state under == ""
  expect state lent == false
  tap "sprint" drag to "slide" hold 200
  expect state arrived == "slide"

test "A finger that slides onto Sprint from Jump holds it until it lifts"
  prefer pointer coarse
  tap "play"
  tap "jump" drag to "sprint" hold 200
  expect state arrived == "sprint"
  expect state lent == false
  expect state under == ""

test "The title offers three races and a holdout"
  expect tree has "race-switchback"
  expect tree has "race-helix"
  expect tree has "arena"

test "The pause menu can switch between every level"
  tap "play"
  tap "pause"
  expect tree has "race-skyline"
  expect tree has "race-switchback"
  expect tree has "race-helix"
  expect tree has "arena-holdout"

test "The holdout opens with combat HUD"
  tap "arena"
  clock +100
  expect tree has "combat-hud"
